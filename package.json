{
  "name": "easy-oauth-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pages:dev": "wrangler pages dev public",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "deploy:fast": "bash scripts/deploy-pages.sh --fast",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:email": "node --experimental-strip-types scripts/test-email.ts",
    "test:visual": "node scripts/visual-test.js"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wrangler": "^3.114.0"
  }
}
